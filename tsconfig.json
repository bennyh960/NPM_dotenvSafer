{
  "compilerOptions": {
    "target": "ES2020",
    "moduleResolution": "Node",
    "rootDir": "src",
    "sourceMap": true,
    "isolatedModules": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "declaration": false,
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "src/dev_only"]
}
